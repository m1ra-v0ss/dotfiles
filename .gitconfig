# git defaults — signing is set up separately (see docs/)

[user]
	name = m1ra-v0ss
	email = m1ra-v0ss@users.noreply.github.com

[core]
	excludesfile = ~/.gitignore_global
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = simple

[alias]
	st = status -sb
	lg = log --oneline --graph --decorate -20
	unstage = reset HEAD --
